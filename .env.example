GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional. Enables AI menu web checks for food/dish/cuisine Ask searches.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
# Keep this under 1000 to stay within Brave Search API monthly free credits.
BRAVE_MONTHLY_REQUEST_LIMIT=900

# Conservative monthly app-side cap for uncached AI searches.
# 1000 uncached Gemini Flash-Lite searches should normally stay under $5.
AI_MONTHLY_REQUEST_LIMIT=your_monthly_uncached_ai_search_limit

# Optional, for a persistent global monthly counter on Vercel KV / Upstash.
# Without these, the cap is only per warm serverless instance.
KV_REST_API_URL=optional_vercel_kv_or_upstash_url
KV_REST_API_TOKEN=optional_vercel_kv_or_upstash_token
